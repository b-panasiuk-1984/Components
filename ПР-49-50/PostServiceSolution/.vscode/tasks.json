{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-postservice",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/PostService/PostService.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-postservice",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/PostService/PostService.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}